# Supabase Postgres Configuration
# Use the "Session pooler" (port 5432) or direct connection string.
# If using the "Transaction pooler" (port 6543), the app disables asyncpg's
# statement cache automatically to stay compatible with pgbouncer.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=columbia-inventory
PINECONE_CATALOG_INDEX_NAME=columbia-catalog-v2
PINECONE_CATALOG_V3_INDEX_NAME=columbia-catalog-v3

# Hugging Face Configuration for Gemma Embeddings
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL_NAME=google/embeddinggemma-300m

# Cartesian Columbia Configuration
CARTESIAN_CLIENT_ID=
CARTESIAN_CLIENT_SECRET=
CARTESIAN_BASE_URL=https://api.cartesian.ai

# OpenRouter (LLM-as-judge for the response feedback evals system)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Auth: JWT + OTP email login
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h
# Set to "development" to have send-otp echo the OTP back in the response for testing
ENVIRONMENT=

# Azure Communication Services (sends OTP emails)
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_SENDER_ADDRESS=

# Redis (OTP storage + JWT logout blocklist)
REDIS_HOST=
REDIS_PORT=6380
REDIS_PASSWORD=
